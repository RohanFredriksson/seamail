{
  "name": "seamail",
  "version": "1.0.0",
  "description": "Local-first developer tool for testing how HTML emails render across reproducible email rendering environments.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "seamail": "bin/seamail.mjs"
  },
  "main": "./src/index.ts",
  "exports": "./src/index.ts",
  "files": [
    "bin",
    "src",
    "environments",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "seamail": "node ./bin/seamail.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "node-html-parser": "^6.1.13",
    "picocolors": "^1.1.1",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.47.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.5.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
